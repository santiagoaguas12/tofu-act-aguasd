# Terraform local state and working files
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variables can contain credentials or environment-specific values
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Terraform local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Keep the dependency lock file versioned
!.terraform.lock.hcl

# Generated Lambda deployment packages
*.zip

# Python cache and local environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials
credentials.*
secrets.*
*.secret

# Cloud credentials/config copied into the project by accident
.aws/
.azure/
.gcloud/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
